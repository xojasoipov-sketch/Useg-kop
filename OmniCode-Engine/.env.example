# OmniCode Engine uchun konfiguratsiya fayli

# GitHub token (shaxsiy access token)
GITHUB_TOKEN=your_github_token_here

# Supabase URL va API kaliti
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# AI API kalitlari
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Loyiha sozlamalari
DEFAULT_BRANCH=main
AUTO_PUSH=true